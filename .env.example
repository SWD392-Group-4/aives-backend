# Cấu hình môi trường cho AIVES Backend
# Đổi tên file thành .env trước khi chạy app (hoặc copy sang .env)

# Môi trường: local (kiểm tra đồng bộ file .env) | deploy (môi trường Render/Cloud, bỏ qua check file .env)
APP_ENV=local

# Database cua AIVES Backend: postgres (mac dinh) | sqlserver | supabase | dev (H2 in-memory)
SPRING_PROFILES_ACTIVE=postgres

# PostgreSQL: database "aives" va cac bang duoc backend tu tao khi khoi dong (tat bang DB_AUTO_CREATE=false)
DB_URL=jdbc:postgresql://localhost:5432/aives
DB_USERNAME=postgres
DB_PASSWORD=mat_khau_user_postgres

# Dung Supabase Cloud: doi SPRING_PROFILES_ACTIVE=supabase va dien thong tin ben duoi:
# (Luu y: Dung pooler port 6543 kem ?sslmode=require&prepareThreshold=0 hoac direct connection port 5432)
#SPRING_PROFILES_ACTIVE=supabase
#DB_URL=jdbc:postgresql://<host-pooler-supabase>:6543/postgres?sslmode=require&prepareThreshold=0
#DB_USERNAME=postgres.<project-ref>
#DB_PASSWORD=<mat_khau_supabase>
#DB_MAX_POOL_SIZE=100

# Van dung SQL Server thi doi SPRING_PROFILES_ACTIVE=sqlserver va DB_URL nhu duoi:
#DB_URL=jdbc:sqlserver://localhost:1433;databaseName=aives;encrypt=true;trustServerCertificate=true
#DB_USERNAME=sa
#DB_PASSWORD=123456

SERVER_PORT=8080

# JWT Secret (BẮT BUỘC >= 32 ký tự bảo mật)
JWT_SECRET=your_super_secret_jwt_key_must_be_over_32_characters_long

# CORS Allowed Origins (Hỗ trợ Frontend Web, Mobile, ngrok, devtunnels hoặc domain deploy)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.trycloudflare.com,https://*.ngrok-free.app,https://*.devtunnels.ms

# Admin mặc định khi khởi tạo dữ liệu
ADMIN_EMAIL=admin@aives.local
ADMIN_PASSWORD=Admin@123
SEED_DEFAULT_PASSWORD=Aives@123

# Gui email khi admin tao tai khoan (mat khau tam). De MAIL_ENABLED=false thi email chi duoc in ra console.
# Gmail: bat xac minh 2 buoc, tao App Password tai https://myaccount.google.com/apppasswords
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
#MAIL_USERNAME= [dia chi gmail dung de gui]
#MAIL_PASSWORD= [App Password 16 ky tu, viet lien khong dau cach]
#MAIL_FROM= [mac dinh = MAIL_USERNAME]
FRONTEND_URL=http://localhost:5173

# AI Gemini: tao key tai https://aistudio.google.com/apikey. De trong thi phong van khong co cau hoi xoay.
#GEMINI_API_KEY= [key cua ban, KHONG commit]
# Model chinh: gemini-3.8-flash = Flash moi nhat (GA, 09/2026), can bang toc do / chat luong tot nhat
GEMINI_MODEL=gemini-3.8-flash
# Model du phong khi model chinh qua tai (HTTP 503), cach nhau bang dau phay.
# KHONG dung gemini-3.7-flash: da deprecated (08/10/2026), Google tu chuyen sang 3.8 nen du phong vo tac dung.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Model rieng cho viec DOC FILE cau hoi / rubric (tach du lieu, khong can suy luan sau).
# Flash-Lite nhanh hon ro ret. De trong = dung GEMINI_MODEL.
GEMINI_IMPORT_MODEL=gemini-3.5-flash-lite
