# Cấu hình môi trường cho AIVES Backend
# Đổi tên file thành .env trước khi chạy app (hoặc copy sang .env)

SPRING_PROFILES_ACTIVE=sqlserver
SERVER_PORT=8080

# Cấu hình Database SQL Server (BẮT BUỘC)
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=aives;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=your_database_password_here

# JWT Secret (BẮT BUỘC >= 32 ký tự bảo mật)
JWT_SECRET=your_super_secret_jwt_key_must_be_over_32_characters_long

# CORS Allowed Origins (Hỗ trợ Frontend dev, tunnel ngrok & devtunnels)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.ngrok-free.app,https://*.devtunnels.ms

# Admin mặc định khi khởi tạo dữ liệu
ADMIN_EMAIL=admin@aives.local
ADMIN_PASSWORD=Admin@123
SEED_DEFAULT_PASSWORD=Aives@123

# Gửi email khi admin tạo tài khoản (mật khẩu tạm). Để MAIL_ENABLED=false thì email chỉ in ra console.
# Gmail: bật xác minh 2 bước, tạo App Password tại https://myaccount.google.com/apppasswords
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
#MAIL_USERNAME=your_gmail@gmail.com
#MAIL_PASSWORD=your_16_char_app_password
#MAIL_FROM=your_gmail@gmail.com
FRONTEND_URL=http://localhost:5173

# AI Gemini: tạo key tại https://aistudio.google.com/apikey. Để trống thì phòng vấn đáp không có câu hỏi xoay.
#GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
