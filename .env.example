# Cấu hình môi trường cho AIVES Backend
# Đổi tên file thành .env trước khi chạy app (hoặc copy sang .env)

SPRING_PROFILES_ACTIVE=sqlserver
SERVER_PORT=8080

# Cấu hình Database SQL Server (BẮT BUỘC)
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=aives;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=your_database_password_here

# JWT Secret (BẮT BUỘC >= 32 ký tự bảo mật)
JWT_SECRET=your_super_secret_jwt_key_must_be_over_32_characters_long

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.ngrok-free.app,https://*.devtunnels.ms

# Admin mặc định khi khởi tạo dữ liệu
ADMIN_EMAIL=admin@aives.local
ADMIN_PASSWORD=Admin@123
SEED_DEFAULT_PASSWORD=Aives@123
